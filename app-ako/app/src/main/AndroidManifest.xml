<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup="false": sin copia en la nube del PIN ni de la base de datos; reinstalar borra todo (aviso de 1b y Anexo II)
         dataExtractionRules: lo mismo para el paso de móvil a móvil de Android 12+ (reglas_extraccion.xml); antes de la api 31 se ignora -->
    <application
        android:name=".EntradaAko"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_extraccion"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AKO">
        <!-- pantalla 1: arranca aquí (LAUNCHER). solo en vertical -->
        <activity
            android:name=".ui.selector.SelectorActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- pantalla 2 (Panel). solo en vertical -->
        <activity
            android:name=".ui.panel.PanelActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- pantalla 5 (Pedir: carta, ficha y carrito). solo en vertical -->
        <activity
            android:name=".ui.pedido.PedidoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- pantalla 6 (Cuenta: rejilla, comanda y recibo). sin PIN. solo en vertical -->
        <activity
            android:name=".ui.cuenta.CuentaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- pantalla 2g (Resumen de ingresos). solo desde el Panel, detrás del PIN: sin intent-filter
             y exported="false", ninguna otra app la puede abrir. solo en vertical -->
        <activity
            android:name=".ui.resumen.ResumenIngresosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- pantalla 3 (formulario del plato). solo en vertical -->
        <activity
            android:name=".ui.plato.PlatoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
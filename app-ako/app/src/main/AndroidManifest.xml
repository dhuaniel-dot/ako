<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false" (P151): sin copia en la nube del PIN ni de la base de datos; así reinstalar
         borra todo, como dicen el aviso de 1b, el spec 8 y el Anexo II -->
    <application
        android:name=".EntradaAko"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AKO">
        <!-- Pantalla 1: arranca aquí (LAUNCHER). Solo en vertical (RNF-15) -->
        <activity
            android:name=".ui.selector.SelectorActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [Claude] Pantalla 2 (Panel), provisional en la S5. Solo en vertical (RNF-15) -->
        <activity
            android:name=".ui.panel.PanelActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
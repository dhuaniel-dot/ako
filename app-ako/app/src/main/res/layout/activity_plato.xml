<?xml version="1.0" encoding="utf-8"?>
<!-- 3a · Formulario del plato (wireframes 03a-formulario-1 y -2): barra arriba, un scroll único
     con todo el formulario y Guardar fijo abajo, fuera del scroll (leyenda 03a-1 #5) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barra superior gris, como la del Panel: «← Atrás» y el título, que pone el código
         («Nuevo plato» o «Editar plato») -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/barraSuperior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAtras"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/comun_atras"
            android:contentDescription="@string/comun_atras_cd"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/botonAtras"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Un solo scroll con todo dentro: aquí no hay listas que reciclen filas (en el Panel sí) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFormulario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/botonGuardar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1 · La foto: el «?» y el botón redondo «+», apagado hasta la S12 (como «+ Elegir» de 2b, P13) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="?attr/colorSurfaceContainerHigh">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/comun_sin_foto_cd"
                    android:src="@drawable/ic_sin_foto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonElegirFoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:contentDescription="@string/plato_elegir_foto_cd"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="@string/comun_mas"
                    android:textSize="24sp"
                    app:cornerRadius="28dp" />
            </FrameLayout>

            <!-- 2 · Nombre (el estilo de todos los campos lo pone el tema, P160) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/plato_hint_nombre">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3 · Número y precio en la misma fila -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Solo cifras y sin signo: «number» no deja entrar el «−» (R8 y R9) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/plato_hint_numero">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/textoNumero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Teclado numérico con decimales; digits deja escribir coma o punto y ningún signo (R8) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoPrecio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/plato_hint_precio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/textoPrecio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789,."
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 4 · Categoría: desplegable (se elige, no se escribe). [Claude] android:theme le pone
                 el mismo retoque de color que al resto de campos (P160), que su estilo propio pierde -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoCategoria"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/plato_hint_categoria"
                android:theme="@style/ThemeOverlay.AKO.CampoTexto">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/textoCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Descripción: opcional y de varias líneas -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/plato_hint_descripcion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textoDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ALÉRGENOS: título y raya; las 14 casillas las crea el código (pieza 7) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/plato_seccion_alergenos"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <GridLayout
                android:id="@+id/rejillaAlergenos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- «En la carta»: también al crear, encendido (P60 A). Apagarlo y guardar ELIMINA el plato (3d) -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptorEnLaCarta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/plato_en_la_carta"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 5 · Guardar fijo abajo, fuera del scroll; apagado hasta que estén los cuatro obligatorios (pieza 8) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonGuardar"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/comun_guardar"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
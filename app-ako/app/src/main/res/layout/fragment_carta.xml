<?xml version="1.0" encoding="utf-8"?>
<!-- 5a · la carta (wireframe 05a): barra con «Salir» y «Mesa N»; debajo, la fila de categorías fija
     (scroll horizontal); debajo, la lista de platos por secciones (scroll vertical). nunca un ScrollView con listas dentro
     abajo a la derecha, flotando sobre la lista, la pastilla del carrito -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/barraSuperior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- «Salir», sin flecha: no es volver atrás, es salir de Pedir (pide el PIN) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonSalir"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/carta_btn_salir"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- «Mesa N» en el centro de la barra; lo escribe el código -->
        <TextView
            android:id="@+id/textoMesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- la fila de categorías: fija bajo la barra, fuera de la lista; solo crece lo que miden sus círculos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filaCategorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />

    <View
        android:id="@+id/separador"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filaCategorias" />

    <!-- la lista de platos por secciones, hasta abajo. [Claude] hueco abajo (clipToPadding false) para que la pastilla no tape el último plato
         88 dp = los 56 de la pastilla y sus dos márgenes de 16 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaPlatos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separador" />

    <!-- la pastilla «Carrito · N · total», abajo a la derecha (no una barra fija, ficha 5)
         gris oscuro con letras claras (los colores del texto al revés: en modo noche se invierte); el texto lo pone el código -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCarrito"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:backgroundTint="?attr/colorOnSurface"
        android:textColor="?attr/colorSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Carrito · 3 · 23,40 €" />

</androidx.constraintlayout.widget.ConstraintLayout>
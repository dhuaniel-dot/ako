<?xml version="1.0" encoding="utf-8"?>
<!-- [Claude] Panel del Propietario PROVISIONAL (S5): solo Atrás, Cambiar PIN y Terminar, para P-M-02 y P-M-03.
     El Panel de verdad (wireframe 02a) lo sustituye en la S6 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barra superior gris con «← Atrás» -->
    <FrameLayout
        android:id="@+id/barraSuperior"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAtras"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:text="@string/comun_atras"
            android:contentDescription="@string/comun_atras_cd"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Barra inferior: Cambiar PIN (con borde) y Terminar (acento), uno al lado del otro -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCambiarPin"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/pin_cambiar_titulo"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/botonTerminar"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonTerminar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/panel_btn_terminar"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/botonCambiarPin" />

</androidx.constraintlayout.widget.ConstraintLayout>
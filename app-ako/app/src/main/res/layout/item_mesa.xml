<?xml version="1.0" encoding="utf-8"?>
<!-- Una mesa de la rejilla (1d y 6a): el número grande y, si tiene comanda, el total debajo.
     Nace como mesa libre (fondo y borde del tema); MesaAdapter la pinta roja si está ocupada -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjetaMesa"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="73dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- S13 (1 → B): el número ocupa el hueco que deja el total y encoge su letra si no cabe
             (con la letra del móvil al máximo); como mucho 24 sp y nunca menos de 12 sp -->
        <TextView
            android:id="@+id/textoNumero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="4" />

        <!-- P130 del Project: 12 sp, el mínimo; solo se ve si la mesa tiene comanda -->
        <TextView
            android:id="@+id/textoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="42,00 €"
            tools:visibility="visible" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>